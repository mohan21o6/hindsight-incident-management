# =============================================================================
# OpsMind AI — Environment Configuration
# =============================================================================

# Server Configuration
PORT=3000

# Hindsight Official API Configuration (Server-side ONLY — never exposed to client)
# Obtain your API key from your Hindsight platform console (e.g. Vectorize.io / Hindsight)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=default

# NOTE:
# If HINDSIGHT_API_KEY is left empty, OpsMind automatically runs in Local Demo Fallback mode.
# When HINDSIGHT_API_KEY is provided, all retain/recall requests are dispatched to the real
# Hindsight Vector Bank via the secure server proxy at /api/hindsight.
